# Supabase project URL (dashboard: Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase ANON (public) key - safe to expose to the browser, RLS applies.
# JWT format, starts with "eyJ..."
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key

# Supabase SERVICE ROLE key - full admin access, bypasses RLS.
# SERVER ONLY: used by src/app/api/* routes and scripts/test-battle.mjs.
# NEVER expose it to the browser, NEVER commit it. If it leaks, rotate it
# immediately in the Supabase dashboard.
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key

# Optional: teacher profile id used by scripts/test-battle.mjs
# (defaults to the first teacher profile found)
# TEACHER_ID=00000000-0000-0000-0000-000000000000
